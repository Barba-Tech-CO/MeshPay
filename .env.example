# Lab server. Compose and the server read these. MIGRATOR_DATABASE_URL and DATABASE_URL are the
# host-side URLs used by tests; containers build their own from the POSTGRES_* and RUNTIME_* values.
POSTGRES_USER=meshpay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meshpay
POSTGRES_HOST_PORT=55432
SERVER_HOST_PORT=18080
SERVER_PORT=8080
MIGRATOR_DATABASE_URL=postgres://meshpay:change-me@127.0.0.1:55432/meshpay
RUNTIME_DB_PASSWORD=change-me
DATABASE_URL=postgres://meshpay_app:change-me@127.0.0.1:55432/meshpay
LAB_MODE=false
SERVER_SIGNING_KEY_FILE=/run/secrets/server_signing_key
INITIAL_GRANT_UNITS=10000
SUPPLY_CAP_UNITS=1000000000000
CAP_CHEQUE_UNITS=1000
CAP_RESERVE_UNITS=5000
CHEQUE_MAX_COUNT=10
CHEQUE_TTL_MAX_SECONDS=86400
BALANCE_AUTH_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=64
REGISTER_LIMIT_PER_MINUTE=30
