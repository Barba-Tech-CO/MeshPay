# Lab server. Compose and the server read these. MIGRATOR_DATABASE_URL and DATABASE_URL are the
# host-side URLs used by tests; containers build their own from the POSTGRES_* and RUNTIME_* values.
# Lab override (builds the server with `--features lab`); drop it for a production build.
COMPOSE_FILE=docker-compose.yml:docker-compose.lab.yml
POSTGRES_USER=meshpay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meshpay
POSTGRES_HOST_PORT=55432
SERVER_HOST_PORT=18080
SERVER_PORT=8080
MIGRATOR_DATABASE_URL=postgres://meshpay:change-me@127.0.0.1:55432/meshpay
RUNTIME_DB_PASSWORD=change-me
DATABASE_URL=postgres://meshpay_app:change-me@127.0.0.1:55432/meshpay
LAB_MODE=false
SERVER_SIGNING_KEY_FILE=/run/secrets/server_signing_key
# Lab ServerKeyCert (30 days; binary built with `--features lab`, as the compose image is): `meshpay_server lab-key-cert <root_seed_file> <server_seed_file> 30`
# prints the root public key (line 1, below) and the cert hex (line 2, server/secrets/server_key_cert.hex).
SERVER_KEY_CERT_FILE=/run/secrets/server_key_cert
# SNAPSHOT key (signs GET /v1/revocation-snapshot): seed in server/secrets/server_snapshot_key.hex,
# cert from `meshpay_server lab-key-cert <root_seed_file> <snapshot_seed_file> 30 snapshot` (line 2).
SERVER_SNAPSHOT_KEY_FILE=/run/secrets/server_snapshot_key
SERVER_SNAPSHOT_KEY_CERT_FILE=/run/secrets/server_snapshot_key_cert
SERVER_ROOT_PUBLIC_KEY_HEX=
INITIAL_GRANT_UNITS=10000
SUPPLY_CAP_UNITS=1000000000000
CAP_CHEQUE_UNITS=1000
CAP_RESERVE_UNITS=5000
CHEQUE_MAX_COUNT=10
CHEQUE_TTL_MAX_SECONDS=86400
BALANCE_AUTH_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
MAX_CONCURRENT_REQUESTS=64
REGISTER_LIMIT_PER_MINUTE=30
CHALLENGE_LIMIT_PER_MINUTE=60
CONTROL_LIMIT_PER_MINUTE=10
PUBLIC_READ_LIMIT_PER_MINUTE=600
ATTESTATION_ROOTS_PEM_FILE=/run/secrets/attestation_roots
ATTESTATION_REVOCATION_FILE=/run/secrets/attestation_revoked
ATTESTATION_CHALLENGE_TTL_SECONDS=60
ALLOW_TEE_ISSUANCE=false
